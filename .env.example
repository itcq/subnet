# Public client configuration only. Copy to .env for local development.
# Obtain the local publishable key from `npm run backend:start` or `npx supabase status`.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=[LOCAL_PUBLISHABLE_KEY]
EXPO_PUBLIC_ACCOUNT_PRIVACY_URL=https://example.test/account-privacy
